#!/bin/sh
# UsableNet AQA Browser — MCP server launcher (macOS / Linux).
#
# Generated by build.mjs from packages/mcp/launcher/aqa-mcp.sh; edit the
# template, not this copy.
#
# The MCP host runs this file as the server command. It finds a Node.js
# 20+ for `mcp-server.js` and execs it with the same arguments
# and stdio. Desktop hosts (the Codex app, Cursor, the Claude desktop app)
# start with the bare login PATH, which on macOS has no Homebrew, nvm, Volta
# or fnm in it — so beyond PATH the launcher looks where those installers put
# Node.js. With no usable Node.js at all it does not let the host fail
# silently: it prints the install steps to stderr (the host's MCP log) and
# then stands in for the server — a minimal MCP server whose one tool,
# `aqa_setup_bridge`, returns those steps — so the agent can tell a user who
# never opens a terminal how to install Node.js.
#
# Nothing here writes to stdout except the stand-in server: that channel is
# the MCP transport.
#
# Environment (optional):
#   AQA_NODE             Path of the node executable to use, tried first.
#   AQA_NODE_NO_SEARCH   Set to 1 to look at AQA_NODE and PATH only (locked-down
#                        machines, tests).
set -u

MIN_NODE_MAJOR=20
LOG='[UsableNet AQA Browser launcher]'
log() { printf '%s %s\n' "$LOG" "$*" >&2; }

here=$(cd "$(dirname "$0")" && pwd)
plugin_root=$(cd "$here/.." && pwd)
server="$plugin_root/mcp-server.js"

# ── Find Node.js ──────────────────────────────────────────────────────────────

best=''          # the newest node seen so far (kept for the too-old report)
best_major=0
best_version=''

# consider <path> — remembers the candidate when it runs and is the newest
# yet; succeeds when it satisfies MIN_NODE_MAJOR.
consider() {
  [ -x "$1" ] || return 1
  version=$("$1" -v 2>/dev/null) || return 1
  major=${version#v}
  major=${major%%.*}
  case "$major" in '' | *[!0-9]*) return 1 ;; esac
  if [ "$major" -gt "$best_major" ]; then
    best=$1
    best_major=$major
    best_version=$version
  fi
  [ "$major" -ge "$MIN_NODE_MAJOR" ]
}

if [ -n "${AQA_NODE:-}" ]; then
  if consider "$AQA_NODE"; then exec "$AQA_NODE" "$server" "$@"; fi
  log "AQA_NODE=$AQA_NODE is not a usable Node.js $MIN_NODE_MAJOR+ (found: ${best_version:-nothing}) — looking elsewhere"
fi

# 1. PATH: the terminal case, and any host that inherits a full shell PATH.
on_path=$(command -v node 2>/dev/null || true)
if [ -n "$on_path" ] && consider "$on_path"; then exec "$on_path" "$server" "$@"; fi

# 2. Where installers put Node.js when PATH doesn't say (desktop hosts).
if [ "${AQA_NODE_NO_SEARCH:-0}" != 1 ]; then
  home=${HOME:-/nonexistent}
  for candidate in \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    /opt/local/bin/node \
    /usr/bin/node \
    /snap/bin/node \
    "$home/.volta/bin/node" \
    "$home/.local/share/fnm/aliases/default/bin/node" \
    "$home/Library/Application Support/fnm/aliases/default/bin/node" \
    "$home/.asdf/shims/node" \
    "$home/.local/share/mise/shims/node" \
    "$home/n/bin/node" \
    "${NVM_DIR:-$home/.nvm}"/versions/node/*/bin/node \
    "$home/.fnm/node-versions"/*/installation/bin/node; do
    consider "$candidate" || true
  done
  if [ -n "$best" ] && [ "$best_major" -ge "$MIN_NODE_MAJOR" ]; then exec "$best" "$server" "$@"; fi
fi

# ── No usable Node.js: say so, then stand in for the server ──────────────────
#
# The stand-in speaks just enough MCP (newline-delimited JSON-RPC over stdio)
# for the host to connect and list one tool. Its `initialize` result carries
# `instructions`, which hosts show the model, so the agent knows what is
# wrong before it calls anything.

case "$(uname -s 2>/dev/null)" in
  Darwin) steps_json=$(cat <<'JSON'
["Open https://nodejs.org/en/download in your browser and click the macOS Installer (.pkg) for the LTS version — no terminal needed.","Open the downloaded .pkg and click Continue through the installer, keeping the default options (it asks for your Mac password once).","Then fully quit and reopen the app you use the agent in (Claude Code, Cursor, the Codex app, VS Code, …) — it only sees Node.js after a restart.","If Node.js is already installed through Homebrew, nvm, Volta or fnm and you still see this, the app cannot see your shell PATH: installing the .pkg as above fixes it, or set the AQA_NODE environment variable of the MCP server to the full path of your node executable."]
JSON
) ;;
  Linux) steps_json=$(cat <<'JSON'
["Install Node.js 20 or newer. The distribution packages are often too old, so prefer the Linux Binaries or the package-manager instructions at https://nodejs.org/en/download.","Then fully quit and reopen the app you use the agent in (Claude Code, Cursor, the Codex app, VS Code, …) — it only sees Node.js after a restart.","If Node.js is installed for your user only (nvm, Volta, fnm) and still not found, set the AQA_NODE environment variable of the MCP server to the full path of your node executable."]
JSON
) ;;
  *) steps_json=$(cat <<'JSON'
["Install Node.js 20 or newer. The distribution packages are often too old, so prefer the Linux Binaries or the package-manager instructions at https://nodejs.org/en/download.","Then fully quit and reopen the app you use the agent in (Claude Code, Cursor, the Codex app, VS Code, …) — it only sees Node.js after a restart.","If Node.js is installed for your user only (nvm, Volta, fnm) and still not found, set the AQA_NODE environment variable of the MCP server to the full path of your node executable."]
JSON
) ;;
esac
instructions_json=$(cat <<'JSON'
"Node.js is not available on this machine, so the UsableNet AQA Browser tools cannot run yet. The one tool here, aqa_setup_bridge, returns the install steps: call it and relay the steps to the user in plain language — they may never use a terminal. Once Node.js is installed the user must fully quit and reopen this app; the real tools appear on its next start."
JSON
)
tool_description_json=$(cat <<'JSON'
"Reports why the UsableNet AQA Browser tools are unavailable on this machine (Node.js missing or too old) and returns step-by-step install instructions written for a non-technical user. Call it whenever the user asks for AQA or accessibility checks, or asks why the tools are missing."
JSON
)
server_name_json=$(cat <<'JSON'
"UsableNet AQA Browser"
JSON
)

# JSON-string-escape a value (quotes and backslashes; the inputs have no newlines).
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

if [ -n "$best" ]; then
  diagnosis=node-too-old
  found_json="{\"path\":\"$(esc "$best")\",\"version\":\"$(esc "$best_version")\"}"
  log "Node.js $best_version at $best is too old — UsableNet AQA Browser needs Node.js $MIN_NODE_MAJOR or newer."
else
  diagnosis=node-missing
  found_json=null
  log "Node.js was not found on this machine (not on PATH, not in the usual install locations) — UsableNet AQA Browser needs Node.js $MIN_NODE_MAJOR or newer."
fi
log "The AQA tools stay unavailable until it is installed. Steps:"
# The steps array holds no literal quotes (build.mjs checks), so splitting on
# the separator is enough to print one numbered line per step.
printf '%s' "$steps_json" | sed -e 's/^\["//' -e 's/"\]$//' | awk -F'","' '{ for (i = 1; i <= NF; i += 1) printf "  %d. %s\n", i, $i }' >&2

result_json="{\"ok\":false,\"diagnosis\":\"$diagnosis\",\"found\":$found_json,\"required\":\"Node.js $MIN_NODE_MAJOR or newer\",\"steps\":$steps_json,\"note\":\"After installing Node.js, fully quit and reopen the app that runs this agent; the AQA tools appear on its next start. Nothing else is wrong: the Chrome extension and the pairing are checked only once the server itself runs.\"}"
result_text=$(esc "$result_json")

reply() { printf '%s\n' "$1"; }

protocol='2024-11-05'
while IFS= read -r line || [ -n "$line" ]; do
  [ -n "$line" ] || continue
  method=$(printf '%s' "$line" | sed -nE 's/.*"method"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p')
  id=$(printf '%s' "$line" | sed -nE 's/.*"id"[[:space:]]*:[[:space:]]*("[^"]*"|[0-9]+).*/\1/p')
  # Notifications carry no id and get no answer; neither does anything else
  # without one (a reply needs the id to echo).
  case "$method" in '' | notifications/*) continue ;; esac
  [ -n "$id" ] || continue
  case "$method" in
    initialize)
      requested=$(printf '%s' "$line" | sed -nE 's/.*"protocolVersion"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p')
      [ -n "$requested" ] && protocol=$requested
      reply "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"protocolVersion\":\"$protocol\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":$server_name_json,\"version\":\"0.3.3\"},\"instructions\":$instructions_json}}"
      ;;
    tools/list)
      reply "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"tools\":[{\"name\":\"aqa_setup_bridge\",\"description\":$tool_description_json,\"inputSchema\":{\"type\":\"object\",\"properties\":{}}}]}}"
      ;;
    tools/call)
      reply "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"$result_text\"}]}}"
      ;;
    ping)
      reply "{\"jsonrpc\":\"2.0\",\"id\":$id,\"result\":{}}"
      ;;
    *)
      reply "{\"jsonrpc\":\"2.0\",\"id\":$id,\"error\":{\"code\":-32601,\"message\":\"Method not found: $(esc "$method") — this stand-in only reports that Node.js is missing\"}}"
      ;;
  esac
done
